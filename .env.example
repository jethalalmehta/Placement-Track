# ========================================================
# Placement Track — Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file containing real secrets.
# ========================================================

# Flask Application Secret Key (for session encryption and flash messages)
FLASK_SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration (Optional; defaults to instance/placement.db)
# DATABASE_PATH="instance/placement.db"

# Gemini API Key (Optional; for AI-assisted resume guidance and suggestions)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Recruitment Integration Webhook Secret (Optional; for authenticated ATS webhooks)
RECRUITMENT_WEBHOOK_SECRET="placement-track-webhook-secret-token"

# App URL (Optional; for self-referential links or deployment behind reverse proxy)
APP_URL="http://localhost:3000"
