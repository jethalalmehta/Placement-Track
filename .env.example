# ========================================================
# Placement Track — Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file containing real secrets.
# ========================================================

# Flask Application Secret Key (for session encryption and flash messages)
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Configuration:
# - Locally: defaults to instance/placement.db
# - On Vercel: defaults to /tmp/placement.db (auto-seeded)
# - For custom/persistent DB: provide the absolute path
# DATABASE_PATH="/tmp/placement.db"

# Resume Storage Directory:
# - Locally: defaults to uploads/resumes
# - On Vercel: defaults to /tmp/uploads/resumes
# UPLOAD_FOLDER="/tmp/uploads/resumes"

# Gemini API Key (Optional; for AI-assisted career recommendations and analysis)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Recruitment Integration Webhook Secret (Optional; for ATS webhooks)
RECRUITMENT_WEBHOOK_SECRET="placement-track-webhook-secret-token"

# App URL (e.g. https://your-project.vercel.app or http://localhost:3000)
APP_URL="https://your-project.vercel.app"
